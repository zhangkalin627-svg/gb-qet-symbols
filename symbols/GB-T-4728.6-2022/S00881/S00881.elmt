    <names>
        <name lang="zh">具有两个铁心，每个铁心有一个二次绕组的电流互感器</name>
        <name lang="en">Current transformer with two cores with one secondary winding on each core</name>
    </names>
    <kindInformations>
        <kindInformation name="type">generic</kindInformation>
        <kindInformation name="function">generic</kindInformation>
