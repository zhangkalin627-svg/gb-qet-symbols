        <name lang="zh">白色闪烁、单向光束的地面航行灯（高架的）</name>
        <name lang="en">White flashing unidirectional-beam aerodrome ground light (elevated)</name>
    </names>
    <kindInformations>
        <kindInformation name="type">generic</kindInformation>
