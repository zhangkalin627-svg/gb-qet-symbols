  <names>
    <name lang="zh">多功能开关器件</name>
    <name lang="en">Multiple-function switching device</name>
  </names>
  <kindInformations>
    <kindInformation name="type">generic</kindInformation>
    <kindInformation name="function">generic</kindInformation>
